#undef ZMK_MOUSE_DEFAULT_MOVE_VAL
#undef ZMK_MOUSE_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers
#define LAYER_ABC 0
#define LAYER_SYM 1
#define LAYER_NAV 2
#define LAYER_FUN 3
#define LAYER_RAT 4

#define KEYS_L \
     0  1  2  3  4 \
    10 11 12 13 14 \
    20 21 22 23 24 \
             30 31

#define KEYS_R \
     5  6  7  8  9 \
    15 16 17 18 19 \
    25 26 27 28 29 \
    32 33

#define LDQT  RA(LBKT)
#define RDQT  RS(RA(LBKT))
#define LSQT  RA(RBKT)
#define RSQT  RS(RA(RBKT))
#define NDASH RA(MINUS)
#define MDASH RS(RA(MINUS))

// Home row mods macro
#define HRML(k1,k2,k3,k4) &hrml LSHFT k1 &hrml LALT k2 &hrml LCTRL k3 &hrml LGUI k4
#define HRMR(k1,k2,k3,k4) &hrmr RGUI k1 &hrmr RCTRL k2 &hrmr RALT k3 &hrmr RSHFT k4

// Make home row hold-tap macro
#define MAKE_HT(NAME, TAP, KEYS, TERM) \
    NAME: NAME { \
        compatible = "zmk,behavior-hold-tap"; \
        #binding-cells = <2>; \
        flavor = "balanced"; \
        require-prior-idle-ms = <150>; \
        tapping-term-ms = <TERM>; \
        retro-tap; \
        bindings = <&kp>, <TAP>; \
        hold-trigger-key-positions = <KEYS>; \
        hold-trigger-on-release; \
    };

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <550>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&sk {
    release-after-ms = <5000>;
    quick-release;
};

/ {
    behaviors {
        // Auto Shift and physical Shift share the same override table.
        as: auto_shift {
            compatible = "zmk,behavior-auto-shift";
            #binding-cells = <1>;
            tapping-term-ms = <175>;
            overrides = <
                COMMA QMARK
                DOT   EXCL
                RSQT  NDASH
                DQT   SQT
                PRCNT AT
                COLON DOT
                STAR  CARET
                EXCL  QMARK
                SEMI  COMMA
                FSLH  BSLH
                LPAR  RPAR
                LBRC  RBRC
                LBKT  RBKT
                LT    GT
                LDQT  RDQT
                LSQT  RSQT
            >;
        };

        repeat: resolved_repeat {
            compatible = "zmk,behavior-resolved-repeat";
            #binding-cells = <0>;
        };

        // Tap dance: screenshot
        // Tap: Cmd+Ctrl+Shift+4 (screenshot to clipboard)
        // Double-tap: Cmd+Shift+5 (screenshot options)
        screenshot: td_screenshot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <230>;
            bindings = <&kp LS(LC(LG(N4)))>, <&kp LS(LG(N5))>;
        };

        // Layer tap
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <240>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Home row mods
        // Sebastian's RETRO_SHIFT keeps Auto Shift mod-taps undecided for 500ms.
        MAKE_HT(hrml, &as, KEYS_R, 500)
        MAKE_HT(hrmr, &as, KEYS_L, 500)
        MAKE_HT(fhrmr, &kp, KEYS_L, 175)
    };

    macros {
        // Sleep (macOS): Ctrl+Cmd+Q, wait 1s, Escape
        // “cheese” is a Googler reference, if you know you know.
        no_cheese: macro_no_cheese {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <1000>;
            bindings
                = <&kp LC(LG(Q))>
                , <&kp ESC>
                ;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LAYER_SYM LAYER_NAV>;
            then-layer = <LAYER_RAT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        abc_layer { // LAYER_ABC
            display-name = "abc";
            bindings = <
                // Row 1
                &as Q &as W &as F &as P &as B
                &as J &as L &as U &as Y &as MINUS
                // Row 2
                HRML(A, R, S, T) &as G
                &as M HRMR(N, E, I, O)
                // Row 3
                &as Z &as X &as C &as D &as V
                &as K &as H &as COMMA &as DOT &as RSQT
                // Row 4
                &sk LSHFT &lt LAYER_SYM SPACE
                &lt LAYER_NAV BSPC &repeat
            >;
        };

        sym_layer { // LAYER_SYM
            display-name = "sym";
            bindings = <
                // Row 1
                &as N1 &as N2 &as N3 &as N4 &as N5
                &as N6 &as N7 &as N8 &as N9 &as N0
                // Row 2
                HRML(PRCNT, MINUS, EQUAL, DQT) &as COLON
                &as SEMI HRMR(LPAR, LBRC, LBKT, LT)
                // Row 3
                &as STAR &as PIPE &as AMPS &as EXCL &as GRAVE
                &as FSLH &as DLLR &as HASH &as LDQT &as LSQT
                // Row 4
                &trans &trans
                &trans &trans
            >;
        };

        nav_layer { // LAYER_NAV
            display-name = "nav";
            bindings = <
                // Row 1
                &none &none &none &none &none
                &none &none &none &none &none
                // Row 2
                &sk LSHFT &sk RALT &sk LCTRL &sk LGUI &none
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &none
                // Row 3
                &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(LS(LA(V)))
                &kp PG_DN &kp END &kp HOME &kp PG_UP &none
                // Row 4
                &trans &trans
                &trans &trans
            >;
        };

        fun_layer { // LAYER_FUN
            display-name = "fun";
            bindings = <
                // Row 1
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                // Row 2
                &kp LSHFT &kp LALT &kp LCTRL &kp LGUI &kp F11
                &kp F12 &fhrmr RGUI C_VOL_DN &fhrmr RCTRL C_MUTE &fhrmr RALT C_VOL_UP &kp RSHFT
                // Row 3
                &none &none &none &none &none
                &none &kp C_PREV &kp C_PP &kp C_NEXT &none
                // Row 4
                &none &none
                &none &none
            >;
        };

        rat_layer { // LAYER_RAT
            display-name = "rat";
            bindings = <
                // Row 1
                &none &none &msc SCRL_DOWN &none &none
                &none &none &mmv MOVE_UP &none &none
                // Row 2
                &none &msc SCRL_RIGHT &msc SCRL_UP &msc SCRL_LEFT &none
                &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none
                // Row 3
                &none &mkp RCLK &mkp MCLK &mkp LCLK &none
                &kp LGUI &kp LCTRL &kp LALT &kp LSHFT &none
                // Row 4
                &trans &trans
                &trans &trans
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Function layer
        combo_fun_layer {
            timeout-ms = <50>;
            key-positions = <30 33>;
            bindings = <&mo LAYER_FUN>;
            layers = <LAYER_ABC>;
        };

        // Bootloader
        combo_bootloader_left {
            timeout-ms = <50>;
            slow-release;
            key-positions = <0 1 2 3>;
            bindings = <&bootloader>;
            layers = <LAYER_FUN>;
        };

        // Sleep (no_cheese)
        combo_no_cheese {
            timeout-ms = <50>;
            slow-release;
            key-positions = <0 1 2 3>;
            bindings = <&no_cheese>;
            layers = <LAYER_ABC>;
        };

        // Screenshot
        combo_screenshot {
            timeout-ms = <50>;
            slow-release;
            key-positions = <6 7 8 9>;
            bindings = <&screenshot>;
            layers = <LAYER_ABC>;
        };

        // Spotlight
        combo_spotlight {
            timeout-ms = <50>;
            slow-release;
            key-positions = <20 21 22 23>;
            bindings = <&kp LG(SPACE)>;
            layers = <LAYER_ABC>;
        };

        // Mute
        combo_mute {
            timeout-ms = <50>;
            slow-release;
            key-positions = <26 27 28 29>;
            bindings = <&kp C_MUTE>;
            layers = <LAYER_ABC>;
        };

        // Esc
        combo_esc {
            timeout-ms = <50>;
            slow-release;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Del
        combo_del {
            timeout-ms = <50>;
            slow-release;
            key-positions = <7 8>;
            bindings = <&kp DEL>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Tab
        combo_tab {
            timeout-ms = <50>;
            slow-release;
            key-positions = <11 12>;
            bindings = <&as TAB>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Backspace
        combo_bspc {
            timeout-ms = <50>;
            slow-release;
            key-positions = <17 18>;
            bindings = <&kp BSPC>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Enter
        combo_enter {
            timeout-ms = <50>;
            slow-release;
            key-positions = <27 28>;
            bindings = <&kp ENTER>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Grave (abc), Space (sym)
        combo_grave {
            timeout-ms = <50>;
            slow-release;
            key-positions = <21 22 23>;
            bindings = <&as GRAVE>;
            layers = <LAYER_ABC>;
        };
        combo_space_left {
            timeout-ms = <50>;
            slow-release;
            key-positions = <21 22 23>;
            bindings = <&kp SPACE>;
            layers = <LAYER_SYM>;
        };
        // Space
        combo_space_right {
            timeout-ms = <50>;
            slow-release;
            key-positions = <26 27 28>;
            bindings = <&kp SPACE>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Caps word
        combo_cap {
            timeout-ms = <50>;
            slow-release;
            key-positions = <21 22>;
            bindings = <&caps_word>;
            layers = <LAYER_ABC LAYER_SYM>;
        };

        // Symbols
        combo_amper {
            timeout-ms = <50>;
            slow-release;
            key-positions = <0 1>;
            bindings = <&as AMPS>;
            layers = <LAYER_ABC>;
        };
        combo_colon {
            timeout-ms = <50>;
            slow-release;
            key-positions = <2 3>;
            bindings = <&as COLON>;
            layers = <LAYER_ABC>;
        };
        combo_star {
            timeout-ms = <50>;
            slow-release;
            key-positions = <5 6>;
            bindings = <&as STAR>;
            layers = <LAYER_ABC>;
        };
        combo_semi {
            timeout-ms = <50>;
            slow-release;
            key-positions = <6 7>;
            bindings = <&as SEMI>;
            layers = <LAYER_ABC>;
        };
        combo_pipe {
            timeout-ms = <50>;
            slow-release;
            key-positions = <8 9>;
            bindings = <&as PIPE>;
            layers = <LAYER_ABC>;
        };
        combo_percent {
            timeout-ms = <50>;
            slow-release;
            key-positions = <10 11>;
            bindings = <&as PRCNT>;
            layers = <LAYER_ABC>;
        };
        combo_dquote {
            timeout-ms = <50>;
            slow-release;
            key-positions = <12 13>;
            bindings = <&as DQT>;
            layers = <LAYER_ABC>;
        };
        combo_lbracket {
            timeout-ms = <50>;
            slow-release;
            key-positions = <15 16>;
            bindings = <&as LBKT>;
            layers = <LAYER_ABC>;
        };
        combo_lparen {
            timeout-ms = <50>;
            slow-release;
            key-positions = <16 17>;
            bindings = <&as LPAR>;
            layers = <LAYER_ABC>;
        };
        combo_less {
            timeout-ms = <50>;
            slow-release;
            key-positions = <18 19>;
            bindings = <&as LT>;
            layers = <LAYER_ABC>;
        };
        combo_dollar {
            timeout-ms = <50>;
            slow-release;
            key-positions = <20 21>;
            bindings = <&as DLLR>;
            layers = <LAYER_ABC>;
        };
        combo_equal {
            timeout-ms = <50>;
            slow-release;
            key-positions = <22 23>;
            bindings = <&as EQUAL>;
            layers = <LAYER_ABC>;
        };
        combo_slash {
            timeout-ms = <50>;
            slow-release;
            key-positions = <25 26>;
            bindings = <&as FSLH>;
            layers = <LAYER_ABC>;
        };
        combo_lbrace {
            timeout-ms = <50>;
            slow-release;
            key-positions = <26 27>;
            bindings = <&as LBRC>;
            layers = <LAYER_ABC>;
        };
        combo_hash {
            timeout-ms = <50>;
            slow-release;
            key-positions = <28 29>;
            bindings = <&as HASH>;
            layers = <LAYER_ABC>;
        };

        // Navigation
        combo_end {
            timeout-ms = <50>;
            slow-release;
            key-positions = <1 3>;
            bindings = <&kp END>;
            layers = <LAYER_ABC>;
        };
        combo_home {
            timeout-ms = <50>;
            slow-release;
            key-positions = <6 8>;
            bindings = <&kp HOME>;
            layers = <LAYER_ABC>;
        };
        combo_left {
            timeout-ms = <50>;
            slow-release;
            key-positions = <11 13>;
            bindings = <&kp LEFT>;
            layers = <LAYER_ABC>;
        };
        combo_up {
            timeout-ms = <50>;
            slow-release;
            key-positions = <16 18>;
            bindings = <&kp UP>;
            layers = <LAYER_ABC>;
        };
        combo_right {
            timeout-ms = <50>;
            slow-release;
            key-positions = <21 23>;
            bindings = <&kp RIGHT>;
            layers = <LAYER_ABC>;
        };
        combo_down {
            timeout-ms = <50>;
            slow-release;
            key-positions = <26 28>;
            bindings = <&kp DOWN>;
            layers = <LAYER_ABC>;
        };
    };
};
